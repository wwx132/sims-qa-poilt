# 千问兼容 OpenAI 的聊天接口；填公司批准的地址和密钥
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=

# 阿里云 Embedding 的 OpenAI 兼容地址；如和聊天同一网关，也要明确模型名
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

ES_URL=
ES_INDEX=
ES_USERNAME=
ES_PASSWORD=
ES_VERIFY_TLS=true
ES_VECTOR_FIELD=embedding
ES_KEYWORD_FIELD=search_text
KEYWORD_TOP_K=10
VECTOR_TOP_K=10
RRF_K=60
FUSED_TOP_K=5

DORIS_HOST=
DORIS_PORT=9030
DORIS_USER=
DORIS_PASSWORD=
DORIS_DATABASE=
DORIS_TIMEOUT_SECONDS=15
MAX_RESULT_ROWS=50
TRACE_LOG_PATH=logs/trace.jsonl
TRACE_LOG_QUESTIONS=false
